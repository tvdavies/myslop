{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/dashboard/*"]
    }
  },
  "include": ["src/dashboard/**/*.ts", "src/dashboard/**/*.tsx", "test/dashboard-ui.test.ts"]
}
