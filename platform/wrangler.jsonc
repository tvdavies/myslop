{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myslop-apps",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "myslop.cloud",
      "custom_domain": true
    },
    {
      "pattern": "myslop.app",
      "custom_domain": true
    },
    {
      "pattern": "auth.myslop.cloud",
      "custom_domain": true
    },
    {
      "pattern": "apps.myslop.app",
      "custom_domain": true
    },
    {
      "pattern": "*.apps.myslop.app/*",
      "zone_name": "myslop.app"
    },
    {
      "pattern": "*.myslop.app/*",
      "zone_name": "myslop.app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "myslop-app-assets"
    },
    {
      "binding": "MAIL_SPOOL",
      "bucket_name": "myslop-mail-spool"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "myslop-apps",
      "database_id": "d5c67bf9-6ec6-4c95-924e-9cf3996d8cd5"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "dispatch_namespaces": [
    {
      "binding": "DISPATCHER",
      "namespace": "myslop-apps-production",
      "outbound": {
        "service": "myslop-apps-outbound",
        "parameters": [
          "policy"
        ]
      }
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*.md"
      ],
      "fallthrough": false
    }
  ],
  "vars": {
    "IDENTITY_LINKING_DEADLINE": "1788825600000",
    "IDENTITY_ASSERTION_KEY_VERSION": "1"
  }
}
