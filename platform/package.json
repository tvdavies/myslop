{
  "name": "myslop-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run generate && bunx wrangler dev",
    "deploy": "bun scripts/deploy.ts",
    "distribute": "bun scripts/gen-distribution.ts",
    "generate": "bun scripts/gen-distribution.ts && bun scripts/gen-dashboard.ts",
    "typecheck": "bun run generate && bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.dashboard.json",
    "test": "bun test test",
    "test:browser": "bunx playwright test",
    "cli": "bun cli/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  }
}
